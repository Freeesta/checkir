{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkir:schema:datasheet:1",
  "title": "Substance sheet data (texts live in testi.<lang>.md)",
  "title_it": "Dati della scheda sostanza (i testi stanno in testi.<lingua>.md)",
  "description": "Substance sheet data (texts live in testi.<lang>.md)",
  "description_it": "Dati della scheda sostanza (i testi stanno in testi.<lingua>.md)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "datasheet/1",
      "description": "Schema name and version.",
      "description_it": "Nome e versione dello schema."
    },
    "substance": {
      "description": "Id of the substance.",
      "description_it": "Id della sostanza.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "Sheet version.",
      "description_it": "Versione della scheda.",
      "type": "integer",
      "minimum": 1
    },
    "section_state": {
