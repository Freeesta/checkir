      ],
      "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
    },
    "structure_svg": {
      "description": "True if data/substances/<id>/structure.svg exists; it is generated from substance.smiles by tools/dati/genera_strutture.py.",
