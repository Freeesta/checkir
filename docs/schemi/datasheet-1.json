          "peak_min": {
            "description": "Peak in minutes.",
            "description_it": "Picco in minuti.",
            "type": "number",
            "minimum": 0
          },
          "duration_h": {
            "description": "Duration in hours.",
            "description_it": "Durata in ore.",
            "type": "number",
            "minimum": 0
          },
          "source": {
            "description": "Source id.",
            "description_it": "Id fonte.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "route",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "interactions": {
      "description": "Interactions.",
