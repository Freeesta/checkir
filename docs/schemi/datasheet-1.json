        "molecule": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "category": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "history": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "origin": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "metabolism": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "cuts": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "effects": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "doses": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "risks": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "interactions": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "counselling": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "sources": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        },
        "license": {
          "description": "Section state; production shows only approved.",
          "description_it": "Stato della sezione; la produzione mostra solo approved.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved"
          ]
        }
      },
      "required": [
        "molecule",
        "category",
        "effects",
        "doses",
        "risks",
        "interactions",
        "sources",
        "license"
      ],
      "additionalProperties": false
    },
    "reviewers": {
      "description": "Reviewers (public name and role).",
      "description_it": "Revisori (nome pubblico e ruolo).",
