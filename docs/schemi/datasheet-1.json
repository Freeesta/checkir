            "minLength": 1
          },
          "role": {
            "description": "Role.",
            "description_it": "Ruolo.",
            "type": "string",
            "enum": [
              "chemist",
              "health"
            ]
          },
          "sections": {
            "description": "Sections signed.",
            "description_it": "Sezioni firmate.",
            "type": "array",
            "items": {
              "description": "Section.",
              "description_it": "Sezione.",
              "type": "string",
              "enum": [
                "molecule",
                "category",
                "history",
                "origin",
                "metabolism",
                "cuts",
                "effects",
                "doses",
                "risks",
                "interactions",
                "counselling",
                "sources",
                "license"
              ]
            },
            "minItems": 1
          },
          "date": {
            "description": "Date.",
            "description_it": "Data.",
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          }
        },
        "required": [
          "public_name",
          "role",
          "sections",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "reviewed": {
      "description": "Date of the last review.",
      "description_it": "Data dell'ultima revisione.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "review_by": {
      "description": "Review deadline, at most 24 months after the review (checked by the validator).",
      "description_it": "Scadenza della revisione, al massimo 24 mesi dopo (controllata dal validatore).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "doses": {
      "description": "Dose rows; empty when show_doses is false.",
      "description_it": "Righe di dosi; vuoto se show_doses è false.",
      "type": "array",
      "items": {
        "description": "Dose row; there is never a 'safe' or 'maximum safe' column.",
        "description_it": "Riga di dosi; non esiste mai una colonna «sicura» o «massima sicura».",
        "type": "object",
        "properties": {
          "route": {
            "description": "Route of administration.",
            "description_it": "Via di assunzione.",
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "description": "Unit.",
            "description_it": "Unità.",
            "type": "string",
            "enum": [
              "mg",
              "ug",
              "g"
            ]
          },
          "threshold": {
            "description": "Threshold dose.",
            "description_it": "Dose soglia.",
            "type": "number",
            "minimum": 0
          },
          "light": {
            "description": "Light dose.",
            "description_it": "Dose leggera.",
            "type": "number",
            "minimum": 0
          },
          "common": {
            "description": "Common dose.",
            "description_it": "Dose comune.",
            "type": "number",
            "minimum": 0
          },
          "strong": {
            "description": "Strong dose.",
            "description_it": "Dose forte.",
            "type": "number",
            "minimum": 0
          },
