            "properties": {
              "substance": {
                "description": "Substance id or name.",
                "description_it": "Id o nome della sostanza.",
                "type": "string",
                "minLength": 1
              },
              "ir_relevant": {
                "description": "True if it shows in the IR spectrum.",
                "description_it": "True se si vede nello spettro IR.",
                "type": "boolean"
