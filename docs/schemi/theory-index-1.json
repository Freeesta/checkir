{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkir:schema:theory-index:1",
  "title": "theory-index/1: index of the chapters of the theory section",
  "title_it": "theory-index/1: indice dei capitoli della sezione Teoria",
  "description": "index of the chapters of the theory section",
  "description_it": "indice dei capitoli della sezione Teoria",
  "type": "object",
  "properties": {
    "schema": {
      "description": "Schema name and version.",
      "description_it": "Nome e versione dello schema.",
      "const": "theory-index/1"
    },
    "lang": {
      "description": "Language of the file.",
      "description_it": "Lingua del file.",
      "type": "string",
      "enum": [
        "it",
        "en"
      ]
    },
    "chapters": {
      "description": "Chapters in order.",
      "description_it": "Capitoli in ordine.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "One chapter.",
        "description_it": "Un capitolo.",
        "type": "object",
        "properties": {
          "n": {
            "description": "Number.",
            "description_it": "Numero.",
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "id": {
            "description": "Id of the chapter.",
            "description_it": "Id del capitolo.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "slug": {
            "description": "File name without extension.",
            "description_it": "Nome del file senza estensione.",
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9-]+$"
          },
          "title": {
            "description": "Title.",
            "description_it": "Titolo.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "n",
          "id",
          "slug",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "lang",
    "chapters"
  ],
  "additionalProperties": false
}
