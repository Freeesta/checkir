{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkir:schema:theory:2",
  "title": "theory/2: a chapter of the theory section",
  "title_it": "theory/2: un capitolo della sezione Teoria",
  "description": "a chapter of the theory section",
  "description_it": "un capitolo della sezione Teoria",
  "type": "object",
  "properties": {
    "schema": {
      "description": "Schema name and version.",
      "description_it": "Nome e versione dello schema.",
      "const": "theory/2"
    },
    "id": {
      "description": "Stable id of the chapter.",
      "description_it": "Id stabile del capitolo.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "n": {
      "description": "Number of the chapter.",
      "description_it": "Numero del capitolo.",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "title": {
      "description": "Title.",
      "description_it": "Titolo.",
      "type": "string",
      "minLength": 1
    },
    "key_message": {
      "description": "Key message: at most 25 words.",
      "description_it": "Messaggio chiave: al massimo 25 parole.",
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "description": "Text for everyone: short paragraphs, at most 120 words in all. Terms of the glossary are written [[id|text]].",
      "description_it": "Testo per tutti: paragrafi brevi, al massimo 120 parole in tutto. I termini del glossario si scrivono [[id|testo]].",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A paragraph or phrase.",
        "description_it": "Un paragrafo o una frase.",
        "type": "string",
        "minLength": 1
      }
    },
    "for_chemists": {
      "description": "Box for chemists: formulas and numbers, at most 250 words in all.",
      "description_it": "Riquadro per chimici: formule e numeri, al massimo 250 parole in tutto.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "A paragraph or phrase.",
        "description_it": "Un paragrafo o una frase.",
        "type": "string",
        "minLength": 1
      }
    },
    "figure": {
      "description": "A figure of the chapter.",
      "description_it": "Una figura del capitolo.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Which figure the page draws.",
          "description_it": "Quale figura disegna la pagina.",
          "type": "string",
          "pattern": "^[a-z]+(_[a-z]+)*$"
        },
        "alt": {
          "description": "Long description of the figure for people who cannot see it.",
          "description_it": "Descrizione lunga della figura per chi non la vede.",
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "description": "Caption.",
          "description_it": "Didascalia.",
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "description": "Texts written inside the drawing.",
          "description_it": "Testi scritti dentro il disegno.",
          "type": "object",
          "additionalProperties": {
            "description": "Text in the language of the file.",
            "description_it": "Testo nella lingua del file.",
            "type": "string",
            "minLength": 1
          }
        },
        "data_table": {
          "description": "Data table that accompanies a figure.",
          "description_it": "Tabella dei dati che accompagna una figura.",
          "type": "object",
          "properties": {
            "caption": {
              "description": "Caption of the table.",
              "description_it": "Didascalia della tabella.",
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "description": "Column headers.",
              "description_it": "Intestazioni delle colonne.",
              "type": "array",
              "minItems": 1,
              "items": {
                "description": "A header.",
                "description_it": "Un'intestazione.",
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "description": "Rows: each has one cell per column.",
              "description_it": "Righe: ognuna ha una cella per colonna.",
              "type": "array",
              "minItems": 1,
              "items": {
                "description": "A row.",
                "description_it": "Una riga.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "description": "A cell.",
                  "description_it": "Una cella.",
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "caption",
            "columns",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "alt",
        "caption"
      ],
      "additionalProperties": false
    },
    "interactive": {
      "description": "An interactive figure; the engine does the calculation, the page draws.",
      "description_it": "Una figura interattiva: il calcolo è del motore, la pagina disegna.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Which interactive the page builds.",
          "description_it": "Quale interattività costruisce la pagina.",
          "type": "string",
          "enum": [
            "spring",
            "modes",
            "dipole"
          ]
        },
        "labels": {
          "description": "Texts of the interactive: names of controls, result sentences with {placeholders}, notes.",
          "description_it": "Testi dell'interattività: nomi dei comandi, frasi del risultato con {segnaposto}, note.",
          "type": "object",
          "additionalProperties": {
            "description": "Text in the language of the file.",
            "description_it": "Testo nella lingua del file.",
            "type": "string",
            "minLength": 1
          }
        },
        "items": {
          "description": "Choices of the interactive.",
          "description_it": "Scelte dell'interattività.",
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "One choice of an interactive figure.",
            "description_it": "Una scelta di una figura interattiva.",
            "type": "object",
            "properties": {
              "id": {
                "description": "Id of the item.",
                "description_it": "Id della voce.",
                "type": "string",
                "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$"
              },
              "label": {
                "description": "Name shown on the button and in the table.",
                "description_it": "Nome mostrato sul pulsante e nella tabella.",
                "type": "string",
                "minLength": 1
              },
              "text": {
                "description": "Explanation (may be empty).",
                "description_it": "Spiegazione (può essere vuota).",
                "type": "string"
              },
              "value": {
                "description": "Value shown in the table, as text (for example a range of wavenumbers).",
                "description_it": "Valore mostrato nella tabella, come testo (per esempio un intervallo di numeri d'onda).",
                "type": "string",
                "minLength": 1
              },
              "params": {
                "description": "Numbers the interactive needs (spring: k, mass A, mass B).",
                "description_it": "Numeri che servono all'interattività (molla: k, massa A, massa B).",
                "type": "array",
                "items": {
                  "description": "A number.",
                  "description_it": "Un numero.",
                  "type": "number"
                }
              }
            },
            "required": [
              "id",
              "label",
              "text",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "labels"
      ],
      "additionalProperties": false
    },
    "further_reading": {
      "description": "Ids of the sources to read next (in fonti.json).",
      "description_it": "Id delle fonti da leggere dopo (in fonti.json).",
      "type": "array",
      "items": {
        "description": "An id.",
        "description_it": "Un id.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "sources": {
      "description": "Ids of the sources of the chapter (in fonti.json).",
      "description_it": "Id delle fonti del capitolo (in fonti.json).",
      "type": "array",
      "items": {
        "description": "An id.",
        "description_it": "Un id.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "glossary_terms": {
      "description": "Ids of the glossary terms used.",
      "description_it": "Id dei termini del glossario usati.",
      "type": "array",
      "items": {
        "description": "An id.",
        "description_it": "Un id.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "n",
    "title",
    "key_message",
    "body",
    "for_chemists",
    "figure",
    "further_reading",
    "sources",
    "glossary_terms"
  ],
  "additionalProperties": false,
  "if": {
    "required": [
      "interactive"
    ]
  },
  "then": {},
  "else": {
    "properties": {
      "figure": {
        "required": [
          "data_table"
        ]
      }
    }
  }
}
