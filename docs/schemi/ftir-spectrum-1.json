{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkir:schema:ftir-spectrum:1",
  "title": "FTIR spectrum metadata (next to the .jdx)",
  "title_it": "Metadati di uno spettro FTIR (accanto al .jdx)",
  "description": "FTIR spectrum metadata (next to the .jdx)",
  "description_it": "Metadati di uno spettro FTIR (accanto al .jdx)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ftir-spectrum/1",
      "description": "Schema name and version.",
      "description_it": "Nome e versione dello schema."
    },
    "id": {
      "description": "<form-id>.<short-source>.<nnn>, e.g. mdma-hcl.checkir.001.",
      "description_it": "<id-forma>.<fonte-breve>.<nnn>, es. mdma-hcl.checkir.001.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*\\.[0-9]{3}$"
    },
    "form": {
      "description": "Id of the form measured.",
      "description_it": "Id della forma misurata.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "role": {
      "const": "reference",
      "description": "Always reference in the library.",
      "description_it": "Sempre reference nella libreria."
    },
    "technique": {
      "description": "Measurement technique.",
      "description_it": "Tecnica di misura.",
      "type": "object",
      "properties": {
        "method": {
          "description": "Method.",
          "description_it": "Metodo.",
          "type": "string",
          "enum": [
            "ATR",
            "transmission",
            "diffuse_reflectance",
            "other"
          ]
        },
        "crystal": {
          "description": "ATR crystal.",
          "description_it": "Cristallo ATR.",
          "type": "string",
          "enum": [
            "diamond",
            "Ge",
            "ZnSe",
            "other"
          ]
        },
        "reflections": {
          "description": "Number of ATR reflections.",
          "description_it": "Numero di riflessioni ATR.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "ATR"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "crystal"
            ]
          }
        }
      ]
    },
    "instrument": {
      "description": "Instrument; never a serial number.",
      "description_it": "Strumento; mai il numero di serie.",
      "type": "object",
      "properties": {
        "manufacturer": {
          "description": "Manufacturer.",
          "description_it": "Produttore.",
          "type": "string",
          "minLength": 1
        },
        "model": {
          "description": "Model.",
          "description_it": "Modello.",
          "type": "string",
          "minLength": 1
        },
        "detector": {
          "description": "Detector.",
          "description_it": "Rivelatore.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "manufacturer",
        "model"
      ],
      "additionalProperties": false
    },
    "resolution_cm1": {
      "description": "Nominal resolution in cm-1.",
      "description_it": "Risoluzione nominale in cm-1.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scans": {
      "description": "Number of co-added scans.",
      "description_it": "Numero di scansioni sommate.",
      "type": "integer",
      "minimum": 1
    },
    "apodization": {
      "description": "Apodization function.",
      "description_it": "Funzione di apodizzazione.",
      "type": "string",
      "minLength": 1
    },
    "range_cm1": {
      "description": "[min, max] wavenumber in cm-1.",
      "description_it": "[min, max] numero d'onda in cm-1.",
      "type": "array",
      "items": {
        "description": "Wavenumber.",
        "description_it": "Numero d'onda.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "step_cm1": {
      "description": "Point spacing in cm-1.",
      "description_it": "Passo in cm-1.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "y_axis": {
      "description": "Y axis of the .jdx.",
      "description_it": "Asse y del .jdx.",
      "type": "string",
      "enum": [
        "absorbance",
        "transmittance"
      ]
    },
    "atr_correction": {
      "description": "Whether an ATR correction was applied.",
      "description_it": "Se è stata applicata una correzione ATR.",
      "type": "boolean"
    },
    "processing": {
      "description": "Processing already applied by the source; empty means raw.",
      "description_it": "Elaborazioni già applicate dalla fonte; vuoto = grezzo.",
      "type": "array",
      "items": {
        "description": "Step.",
        "description_it": "Passo.",
        "type": "string",
        "minLength": 1
      }
    },
    "measured": {
      "description": "Month of the measurement, YYYY-MM.",
      "description_it": "Mese della misura, AAAA-MM.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "provenance": {
      "description": "Provenance of the material.",
      "description_it": "Provenienza del materiale.",
      "type": "object",
      "properties": {
        "type": {
          "description": "Kind of material; unconfirmed_sample never enters a public library.",
          "description_it": "Tipo di materiale; unconfirmed_sample non entra mai in una libreria pubblica.",
          "type": "string",
          "enum": [
            "certified_standard",
            "reference_material",
            "confirmed_sample",
            "unconfirmed_sample"
          ]
        },
        "supplier": {
          "description": "Supplier of the material (an organisation, not a person).",
          "description_it": "Fornitore del materiale (un ente, non una persona).",
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "description": "Manufacturer batch of a standard (never a sample code of a service).",
          "description_it": "Lotto del produttore di uno standard (mai un codice di campione di un servizio).",
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "description": "Techniques and bodies that confirmed the identity.",
          "description_it": "Tecniche ed enti che hanno confermato l'identità.",
          "type": "array",
          "items": {
            "description": "Confirmation.",
            "description_it": "Conferma.",
            "type": "object",
            "properties": {
              "technique": {
                "description": "Technique.",
                "description_it": "Tecnica.",
                "type": "string",
                "minLength": 1
              },
              "body": {
                "description": "Body.",
                "description_it": "Ente.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "technique",
              "body"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "confirmed_sample"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ],
            "properties": {
              "confirmation": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "library": {
      "description": "Library the spectrum belongs to.",
      "description_it": "Libreria a cui appartiene lo spettro.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Library id, e.g. checkir-community.",
          "description_it": "Id libreria, es. checkir-community.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "description": "Library version.",
          "description_it": "Versione della libreria.",
          "type": "string",
          "minLength": 1
        },
        "original_id": {
          "description": "Id in the original library.",
          "description_it": "Id nella libreria d'origine.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "contributors": {
      "description": "Contributors.",
      "description_it": "Contributori.",
      "type": "array",
      "items": {
        "description": "Contributor under a public name (pseudonym allowed).",
        "description_it": "Contributore col nome pubblico (pseudonimo ammesso).",
        "type": "object",
        "properties": {
          "public_name": {
            "description": "Public name.",
            "description_it": "Nome pubblico.",
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "description": "ORCID.",
            "description_it": "ORCID.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          },
          "body": {
            "description": "Body (service or laboratory).",
            "description_it": "Ente (servizio o laboratorio).",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "public_name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "license": {
      "description": "SPDX id: CC-BY-4.0 or LicenseRef-permission-<body> for third parties.",
      "description_it": "Id SPDX: CC-BY-4.0 oppure LicenseRef-permission-<ente> per i terzi.",
      "type": "string",
      "pattern": "^(CC-BY-4\\.0|LicenseRef-permission-[a-z0-9-]+)$"
    },
    "sha256": {
      "description": "SHA-256 of the .jdx file, lowercase hex.",
      "description_it": "SHA-256 del file .jdx, esadecimale minuscolo.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_format": {
      "description": "Format of the source file, e.g. JCAMP-DX 5.01 (OMNIC).",
      "description_it": "Formato del file d'origine, es. JCAMP-DX 5.01 (OMNIC).",
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "description": "Quality metrics computed by CI (ARCHITETTO_DATI_2 §8).",
      "description_it": "Metriche di qualità calcolate dalla CI (§8).",
      "type": "object",
      "properties": {
        "checks": {
          "description": "One result per criterion.",
          "description_it": "Un esito per criterio.",
          "type": "array",
          "items": {
            "description": "Check result.",
            "description_it": "Esito del controllo.",
            "type": "object",
            "properties": {
              "criterion": {
                "description": "Criterion id.",
                "description_it": "Id del criterio.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "result": {
                "description": "Result.",
                "description_it": "Esito.",
                "type": "string",
                "enum": [
                  "pass",
                  "warning",
                  "fail"
                ]
              },
              "value": {
                "description": "Measured value, if numeric.",
                "description_it": "Valore misurato, se numerico.",
                "type": "number"
              }
            },
            "required": [
              "criterion",
              "result"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false
    },
    "review": {
      "description": "Review state.",
      "description_it": "Stato della revisione.",
      "type": "object",
      "properties": {
        "state": {
          "description": "State.",
          "description_it": "Stato.",
          "type": "string",
          "enum": [
            "proposed",
            "in_review",
            "approved",
            "withdrawn"
          ]
        },
        "reviewers": {
          "description": "Public names of the reviewers.",
          "description_it": "Nomi pubblici dei revisori.",
          "type": "array",
          "items": {
            "description": "Name.",
            "description_it": "Nome.",
            "type": "string",
            "minLength": 1
          }
        },
        "date": {
          "description": "Date of the last state change.",
          "description_it": "Data dell'ultimo cambio di stato.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        }
      },
      "required": [
        "state",
        "reviewers",
        "date"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "form",
    "role",
    "technique",
    "instrument",
    "resolution_cm1",
    "range_cm1",
    "step_cm1",
    "y_axis",
    "atr_correction",
    "processing",
    "measured",
    "provenance",
    "library",
    "contributors",
    "license",
    "sha256",
    "original_format",
    "quality",
    "review"
  ],
  "additionalProperties": false
}
